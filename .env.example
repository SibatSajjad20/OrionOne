# ==============================================================================
# Orion One - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In Hostinger hPanel, configure these in "Environment Variables" for your Node.js Web App.
# ==============================================================================

# Node runtime environment
NODE_ENV=production

# Server listening port (Hostinger sets this automatically to the assigned port)
PORT=3000

# Optional: Agentation Visual Feedback Toolbar (development only; disable in production)
# Values: true | false
NEXT_PUBLIC_ENABLE_AGENTATION=false

# Optional: Agentation local backend endpoint (only if Agentation is enabled)
# Default: http://localhost:4747
NEXT_PUBLIC_AGENTATION_ENDPOINT=http://localhost:4747
